# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres / TimescaleDB (docker-compose)
POSTGRES_USER=fwr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fwr
DATABASE_URL=postgresql+psycopg://fwr:change-me@localhost:5433/fwr
# Separate database for backend/tests (the suite drops and rebuilds its schema). Must differ from DATABASE_URL.
# Create it once: docker compose exec db psql -U fwr -d fwr -c 'CREATE DATABASE fwr_test'
TEST_DATABASE_URL=postgresql+psycopg://fwr:change-me@localhost:5433/fwr_test

# Flask
FLASK_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=5055
# Optional: gunicorn gthread worker threads (default 4; one process so the in-process caches stay shared)
GUNICORN_THREADS=4

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Optional: seconds per Gemini HTTP attempt for every call except photo enrichment (default 30; worst case with
# the one retry is 2 x this + 1.5 s, which must stay under gunicorn's 120 s timeout, so keep it at or below 55)
# GEMINI_TIMEOUT_S=30

# Google Sign-In: the iOS OAuth client ID(s), comma-separated. The backend accepts a Google ID token
# only if its `aud` is one of these. Not a secret; steps are in docs/SETUP.md.
GOOGLE_IOS_CLIENT_IDS=

# ML inference service (runs off-box / on a GPU). Empty = Gemini-vision fallback for photos;
# receipts need it. The service's own settings (YOLO_WEIGHTS, FRESHNESS_WEIGHTS, OCR_BACKEND,
# DETECTOR_BACKEND, ...) are documented in docs/ML.md and set where the service runs.
ML_SERVICE_URL=
# With the compose `ml` profile (docker compose --profile ml up -d --build): ML_SERVICE_URL=http://ml:8000.
# ML_MODELS_DIR holds detector.pt + freshness.pt (default ../mldata/models/current); YOLO_DEVICE cpu or 0 (GPU).
ML_MODELS_DIR=
YOLO_DEVICE=
# ML receipt OCR service only. OCR_BACKEND accepts fake, glm or off; compose default is off.
OCR_BACKEND=off
# Set to 1 to preload the OCR engine at service startup.
OCR_WARMUP=0
# Optional: host-only model download token. Public GLM-OCR needs no token; never add it to Compose,
# Dockerfiles or images.
HF_TOKEN=

# ML dataset downloads (only needed where datasets are prepared: the Mac, or as Colab secrets)
# Roboflow: use the PRIVATE API key (Settings > API Keys); the rf_-prefixed publishable key cannot download.
ROBOFLOW_API_KEY=
# Kaggle: API token (Bearer), from kaggle.com > Settings > API > Create New Token
KAGGLE_API_TOKEN=

# Data pipeline (docs/PIPELINE.md). All optional; defaults shown.
# PIPELINE_DATA=pipeline/data
# OCR_TIMEOUT_S=180
# PIPELINE_MAX_EXTRACT_GB=20

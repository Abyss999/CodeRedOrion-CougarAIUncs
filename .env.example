# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres / TimescaleDB (docker-compose)
POSTGRES_USER=fwr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fwr
DATABASE_URL=postgresql+psycopg://fwr:change-me@localhost:5433/fwr
# Separate database for backend/tests (the suite drops and rebuilds its schema). Must differ from DATABASE_URL.
# Create it once: docker compose exec db psql -U fwr -d fwr -c 'CREATE DATABASE fwr_test'
TEST_DATABASE_URL=postgresql+psycopg://fwr:change-me@localhost:5433/fwr_test

# Flask
FLASK_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=5055

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# ML inference service (runs off-box / on a GPU). Empty = Gemini-vision fallback for photos;
# receipts need it. The service's own settings (YOLO_WEIGHTS, FRESHNESS_WEIGHTS, OCR_BACKEND,
# DETECTOR_BACKEND, ...) are documented in docs/ML.md and set where the service runs.
ML_SERVICE_URL=

# ML dataset downloads (only needed where datasets are prepared: the Mac, or as Colab secrets)
# Roboflow: use the PRIVATE API key (Settings > API Keys); the rf_-prefixed publishable key cannot download.
ROBOFLOW_API_KEY=
# Kaggle: API token (Bearer), from kaggle.com > Settings > API > Create New Token
KAGGLE_API_TOKEN=

# Data pipeline (docs/PIPELINE.md). All optional; defaults shown.
# PIPELINE_DATA=pipeline/data
# OCR_TIMEOUT_S=180
# PIPELINE_MAX_EXTRACT_GB=20

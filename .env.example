# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres / TimescaleDB (docker-compose)
POSTGRES_USER=fwr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fwr
DATABASE_URL=postgresql+psycopg://fwr:change-me@localhost:5433/fwr

# Flask
FLASK_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=5055

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-model-id-confirm-in-DECISIONS

# ML inference service (runs off-box / on a GPU). Empty = Gemini-vision fallback.
ML_SERVICE_URL=

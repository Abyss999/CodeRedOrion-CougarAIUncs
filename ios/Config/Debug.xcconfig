#include "Base.xcconfig"
// `$()` stops xcconfig treating `//` as a comment. A runtime override (Debug settings sheet,
// UserDefaults) takes precedence over this. Simulator reaches the host's 127.0.0.1 directly.
API_BASE_URL = http:/$()/127.0.0.1:5055
// Last, so Local.xcconfig overrides everything above. Optional: builds work without it.
#include? "../Local.xcconfig"
